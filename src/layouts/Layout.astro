---
import '../styles/style.css';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}
const { title = 'Bhim Majhi' } = Astro.props;
const base = import.meta.env.BASE_URL; // '/' on GitHub Pages (bhimmajhi.github.io)
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>

  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg?v=1001`} />
  <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96.png?v=1001`} />
  <link rel="shortcut icon" href={`${base}favicon.ico?v=1001`} />
  <link rel="apple-touch-icon" href={`${base}assets/images/apple-touch-icon.png?v=1001`} />
  <link rel="manifest" href={`${base}manifest.webmanifest?v=1001`} />
  <meta name="theme-color" content="#ffffff" />
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Bhim Majhi" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Faculty+Glyphic&display=swap" rel="stylesheet">
</head>
<body>
  <canvas id="particles-bg" aria-hidden="true"></canvas>
  <div class="premium-aura" aria-hidden="true"></div>
  <div class="premium-aura-2" aria-hidden="true"></div>
  <div class="glow-orb"></div>
  <div class="glow-orb-2"></div>

  <div class="container">
    <slot />
    <Footer />
  </div>
</body>
</html>
