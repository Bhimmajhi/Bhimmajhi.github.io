---
import Layout from '../layouts/Layout.astro';
import '../styles/login.css';

const base = import.meta.env.BASE_URL; // '/' on GitHub Pages (bhimmajhi.github.io)
---
<Layout title="Login · Bhim Majhi">
  <main class="login-wrap">
    <a class="login-logo" href={base}><span>Bhim</span>Majhi</a>

    <section class="login-card" data-home={base}>
      <div class="login-head">
        <h1>Welcome <strong>Back</strong></h1>
        <p>Sign in to continue to the site</p>
      </div>

      <form id="loginForm" class="login-form" novalidate>
        <div class="field">
          <i class="fas fa-envelope field-icon" aria-hidden="true"></i>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Email address"
            aria-label="Email address"
            autocomplete="email"
          >
        </div>

        <div class="field">
          <i class="fas fa-lock field-icon" aria-hidden="true"></i>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Password"
            aria-label="Password"
            autocomplete="current-password"
          >
          <button type="button" class="pw-toggle" id="togglePassword" aria-label="Show password">
            <i class="fas fa-eye" aria-hidden="true"></i>
          </button>
        </div>

        <p class="form-msg" id="formMsg" role="status" aria-live="polite"></p>

        <div class="form-options">
          <label class="remember">
            <input type="checkbox" id="remember" checked>
            <span class="checkbox" aria-hidden="true"></span>
            Remember me
          </label>
          <button type="button" class="forgot" id="forgotBtn">Forgot password?</button>
        </div>

        <button type="submit" class="btn-primary" id="submitBtn">
          Sign In <i class="fas fa-arrow-right" aria-hidden="true"></i>
        </button>
      </form>

      <div class="or"><span>or continue with</span></div>

      <div class="socials">
        <button type="button" class="social social-google" data-provider="google" aria-label="Continue with Google">
          <i class="fab fa-google" aria-hidden="true"></i>
        </button>
        <button type="button" class="social social-github" data-provider="github" aria-label="Continue with GitHub">
          <i class="fab fa-github" aria-hidden="true"></i>
        </button>
        <button type="button" class="social social-fb" data-provider="facebook" aria-label="Continue with Facebook">
          <i class="fab fa-facebook-f" aria-hidden="true"></i>
        </button>
      </div>

      <p class="signup">
        Don't have an account?
        <a href="#" id="signupLink">Sign Up <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
      </p>
    </section>
  </main>

  <script is:inline src={`${base}js/particles.js`}></script>
  <script is:inline type="module" src={`${base}js/login.js`}></script>
</Layout>
